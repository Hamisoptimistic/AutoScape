<UserControl x:Class="MetroHub.Presentation.Controls.TileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MetroHub.Presentation.Converters"
             mc:Ignorable="d"
             Margin="4"
             Cursor="Hand"
             Focusable="False">

    <UserControl.Resources>
        <conv:TileSpanToPixelsConverter x:Key="SpanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Background="#20FFFFFF"
            Width="{Binding SpanX, Converter={StaticResource SpanConverter}}"
            Height="{Binding SpanY, Converter={StaticResource SpanConverter}}"
            RenderTransformOrigin="0.5,0.5">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Opacity" Value="1.0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                        <Setter Property="BorderBrush" Value="#9060CDFF"/>
                        <Setter Property="Background" Value="#35FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.RenderTransform>
            <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Resize">
                    <MenuItem Header="Small (1x1)" Click="OnResizeSmallClick" />
                    <MenuItem Header="Medium (2x2)" Click="OnResizeMediumClick" />
                    <MenuItem Header="Wide (4x2)" Click="OnResizeWideClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Run as Administrator" Click="OnRunAsAdminClick" />
                <MenuItem Header="Open File Location" Click="OnOpenFileLocationClick" />
                <Separator />
                <MenuItem Header="Unpin from MetroHub" Click="OnUnpinClick" Foreground="#FF6B6B" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Margin="10">
            <!-- 1x1 Small Tile Layout -->
            <Grid Visibility="{Binding IsSmall, Converter={StaticResource BoolToVis}}">
                <Image Source="{Binding IconPath}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="32" Height="32"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- 2x2 Medium Tile Layout -->
            <Grid Visibility="{Binding IsMedium, Converter={StaticResource BoolToVis}}">
                <Image Source="{Binding IconPath}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="48" Height="48"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Left"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="#E6FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="100" />
            </Grid>

            <!-- 4x2 Wide Tile Layout -->
            <Grid Visibility="{Binding IsWide, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{Binding IconPath}"
                       VerticalAlignment="Center"
                       Width="52" Height="52"
                       Margin="4,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TargetPath}"
                               FontSize="11"
                               Foreground="#80FFFFFF"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
