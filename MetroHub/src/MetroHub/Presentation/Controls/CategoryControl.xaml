<UserControl x:Class="MetroHub.Presentation.Controls.CategoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:MetroHub.Presentation.Controls"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d" 
             Margin="0,0,32,24"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDropFile">

    <StackPanel>
        <!-- Category Header -->
        <DockPanel Margin="6,0,6,10">
            <TextBox x:Name="HeaderTextBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#F0FFFFFF"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     LostFocus="OnHeaderLostFocus"
                     KeyDown="OnHeaderKeyDown"
                     Cursor="IBeam" />

            <Button DockPanel.Dock="Right"
                    Content="+"
                    Width="28" Height="28"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#A0FFFFFF"
                    Background="#1AFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Add shortcut to this category"
                    Click="OnAddTileClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <!-- Tiles WrapPanel -->
        <ItemsControl ItemsSource="{Binding Tiles}"
                      dd:DragDrop.IsDragSource="True"
                      dd:DragDrop.IsDropTarget="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" Width="440" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:TileControl TileActivated="OnTileActivated"
                                          TileUnpinned="OnTileUnpinned" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ghost [ + ] Slot Tile at the end of the group -->
        <Border Margin="6,8,6,6"
                Width="120" Height="56"
                HorizontalAlignment="Left"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#33FFFFFF"
                Background="#0DFFFFFF"
                Cursor="Hand"
                ToolTip="Click or Drop .exe/.lnk here to pin"
                MouseDown="OnGhostTileMouseDown"
                MouseEnter="OnGhostTileMouseEnter"
                MouseLeave="OnGhostTileMouseLeave">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,6,0"/>
                <TextBlock Text="Add Tile" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
